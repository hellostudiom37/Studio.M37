# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# raw dropped-in assets: never commit these directly (may carry EXIF/GPS metadata,
# can be large originals) — scripts/prepare-assets.mjs processes them into the
# cropped/sanitized files under public/, which ARE committed.
/source-assets/*
!/source-assets/.gitkeep

# generated at build time by scripts/sync-projects.mjs — safe to regenerate,
# not worth double-storing alongside content/projects/
/public/projects/
/src/data/projects.generated.json
/src/data/assets-status.generated.json
/src/data/asset-hashes.generated.json

# typescript
*.tsbuildinfo
next-env.d.ts
